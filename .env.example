# Gerado automaticamente pelo Railway quando você adiciona o plugin Postgres
DATABASE_URL=postgresql://user:password@host:port/dbname

# Senha para acessar o painel /admin
ADMIN_PASSWORD=escolha-uma-senha-forte

# Segredo usado para assinar o cookie de sessão (qualquer string aleatória longa)
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
